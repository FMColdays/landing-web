---
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../config/site.mjs';
---
<section id="contacto" class="bg-ink py-20 text-white md:py-26">
 <div class="shell grid gap-12 lg:grid-cols-2 lg:gap-20">
  <div><p class="eyebrow mb-6 text-lime">De una idea a una conversación</p><h2 class="section-heading">Hagamos que<br />tu negocio<br /><span class="text-lime">se vea tan bien<br />como lo que hace.</span></h2><p class="mt-7 max-w-md text-lg leading-relaxed text-white/75">Cuéntame un poco de tu proyecto. Te ayudo a definir el siguiente paso y preparo una cotización a tu medida.</p><div class="mt-9 space-y-4"><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="flex w-fit items-center gap-3 text-base hover:text-lime"><Icon name="whatsapp" />{site.phone}</a><a href={`mailto:${site.email}`} class="flex w-fit items-center gap-3 text-base hover:text-lime"><Icon name="mail" />{site.email}</a></div></div>
  <div class="self-start rounded-3xl bg-paper p-6 text-ink md:p-9">
   <h3 class="font-display text-2xl font-semibold tracking-tight">Tu próxima web empieza aquí.</h3><p class="mt-2 text-sm text-muted">Sin compromiso. Sin tener todas las respuestas.</p>
   <form id="quote-form" class="mt-7 space-y-5" data-phone={site.whatsapp} data-email={site.email}>
    <div><label for="name" class="mb-2 block text-sm font-medium">¿Cómo te llamas?</label><input id="name" name="name" autocomplete="given-name" required minlength="2" maxlength="80" placeholder="Tu nombre" /></div>
    <div><label for="business" class="mb-2 block text-sm font-medium">Tu negocio o proyecto</label><input id="business" name="business" autocomplete="organization" required minlength="2" maxlength="120" placeholder="Nombre y a qué te dedicas" /></div>
    <div><label for="service" class="mb-2 block text-sm font-medium">¿Qué tienes en mente?</label><select id="service" name="service"><option>Una landing page</option><option>Un sitio para mi negocio</option><option>Mejorar mi página actual</option><option>Necesito orientación</option></select></div>
    <div><label for="message" class="mb-2 block text-sm font-medium">Cuéntame un poco más <span class="font-normal text-muted">(opcional)</span></label><textarea id="message" name="message" rows="3" maxlength="600" placeholder="Qué ofreces, dónde atiendes o qué te gustaría lograr…"></textarea></div>
    <button type="submit" class="button button-primary w-full">Preparar mi consulta <Icon name="arrow" /></button>
    <p class="text-xs leading-relaxed text-muted">Podrás revisar tu mensaje antes de enviarlo por WhatsApp o correo. Consulta cómo se usa tu información en <a href="/privacidad/" class="underline underline-offset-3">Privacidad y contacto</a>.</p>
    <noscript><p class="text-sm">Para cotizar, <a href={whatsappUrl} class="underline">escríbeme directamente por WhatsApp</a> o al correo de esta sección.</p></noscript>
   </form>
   <div id="quote-preview" hidden class="mt-6 rounded-2xl border border-line bg-white p-5" role="region" aria-labelledby="preview-title" tabindex="-1">
    <h4 id="preview-title" class="font-semibold">Tu mensaje está listo para revisar</h4><p class="mt-2 text-sm text-muted">Todavía no se ha enviado. Elige dónde continuar:</p>
    <p id="prepared-message" class="mt-4 whitespace-pre-wrap break-words text-sm leading-relaxed text-muted"></p>
    <a id="send-whatsapp" target="_blank" rel="noopener noreferrer" class="button button-dark mt-5 w-full" href={whatsappUrl}>Continuar en WhatsApp <Icon name="whatsapp" /></a>
    <a id="send-email" href={`mailto:${site.email}`} class="mt-4 flex min-h-11 items-center justify-center gap-2 text-sm font-semibold underline underline-offset-4">Abrir mi aplicación de correo <Icon name="mail" class="size-4" /></a>
    <p class="mt-3 text-xs text-muted">Si no se abre tu aplicación, puedes copiar el mensaje y escribir a {site.email}.</p>
   </div>
   <p id="form-status" class="mt-3 text-sm text-muted" role="status" aria-live="polite"></p>
  </div>
 </div>
</section>
<script>
 import { createInquiry } from '../lib/inquiry';
 const form = document.querySelector<HTMLFormElement>('#quote-form');
 const preview = document.querySelector<HTMLElement>('#quote-preview');
 const status = document.querySelector<HTMLElement>('#form-status');
 form?.addEventListener('input', () => { if (preview) preview.hidden = true; if (status) status.textContent = ''; });
 form?.addEventListener('submit', event => {
  event.preventDefault();
  if (!form.reportValidity()) return;
  const data = new FormData(form);
  const inquiry = createInquiry({ name: String(data.get('name') || ''), business: String(data.get('business') || ''), service: String(data.get('service') || ''), message: String(data.get('message') || '') }, form.dataset.phone || '', form.dataset.email || '');
  if (!inquiry) { if (status) status.textContent = 'Escribe tu nombre y tu negocio para preparar la consulta.'; return; }
  const text = document.querySelector('#prepared-message');
  const whatsapp = document.querySelector<HTMLAnchorElement>('#send-whatsapp');
  const email = document.querySelector<HTMLAnchorElement>('#send-email');
  if (text) text.textContent = inquiry.message;
  if (whatsapp) whatsapp.href = inquiry.whatsappUrl;
  if (email) email.href = inquiry.emailUrl;
  if (preview) { preview.hidden = false; preview.focus(); }
  if (status) status.textContent = 'Consulta preparada. Falta enviarla desde WhatsApp o tu correo.';
 });
</script>
