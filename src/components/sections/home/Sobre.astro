---
import IconDiagonal from '@icons/IconDiagonal.svg'
import IconPin from '@icons/IconPin.svg'
import { whatsappUrl } from '@config/site.mjs'

const sealPoints = Array.from({ length: 32 }, (_, i) => {
  const angle = (i / 32) * Math.PI * 2 - Math.PI / 2
  const radius = i % 2 ? 48 : 55
  return `${60 + Math.cos(angle) * radius},${60 + Math.sin(angle) * radius}`
}).join(' ')
---

<section
  id='sobre-mi'
  class='mx-auto w-full max-w-6xl px-6 sm:px-10 lg:px-16 grid items-center gap-12 py-20 md:grid-cols-[.8fr_1.2fr] md:py-26'
>
  <div class='relative mt-8 mr-3 mb-5' data-profile-scene>
    <div class='pointer-events-none absolute inset-0 -rotate-5 rounded-4xl border border-stroke bg-secondary' aria-hidden='true'></div>
    <div
      data-profile-card
      class='relative flex min-h-88 flex-col justify-between rounded-4xl bg-primary p-8 text-ink shadow-[0_24px_42px_-25px_rgb(36_37_33/0.35)] lg:p-9'
    >
      <div class='flex items-center justify-between gap-4'>
        <span class='text-sm font-medium'>Detrás de tu próxima web</span>
        <span class='text-xs font-semibold tracking-tight'>E / W</span>
      </div>
      <p class='my-7 font-display text-[clamp(3.5rem,5vw,4.5rem)] leading-[1.03] font-semibold tracking-[-0.065em]'>
        Hola, soy
        <br />
        <span class='relative inline-block'>
          <span class='relative z-10'>Erick.</span>
          <svg
            class='pointer-events-none absolute -inset-x-4 -inset-y-2 h-[calc(100%+1rem)] w-[calc(100%+2rem)] overflow-visible'
            viewBox='0 0 260 100'
            fill='none'
            aria-hidden='true'
          >
            <path
              d='M243 38C216 4 98-5 35 16C-8 30 1 77 47 88C102 102 210 89 244 67C273 48 234 15 185 11'
              stroke='var(--color-secondary)'
              stroke-width='3.5'
              stroke-linecap='round'
              data-profile-doodle
            />
          </svg>
        </span>
      </p>
      <p class='flex max-w-[75%] items-start gap-2 text-sm font-medium leading-relaxed'>
        <IconPin class='mt-0.5 size-4 shrink-0' />{' '}
        <span>
          Tuxtla Gutiérrez,
          <br />
          Chiapas
        </span>
      </p>
      <svg
        class='pointer-events-none absolute -right-2 -bottom-7 size-24 -rotate-12 drop-shadow-[0_6px_5px_rgb(36_37_33/0.12)] sm:-right-5 sm:size-28'
        viewBox='0 0 120 120'
        aria-hidden='true'
        data-profile-stamp
      >
        <polygon points={sealPoints} fill='var(--color-secondary)' stroke='var(--color-ink)' stroke-width='1.5' stroke-linejoin='round' />
        <circle cx='60' cy='60' r='38' fill='none' stroke='var(--color-ink)' stroke-dasharray='2 4' />
        <text
          x='60'
          y='43'
          text-anchor='middle'
          font-size='8'
          font-weight='600'
          letter-spacing='1.5'
          fill='var(--color-ink)'
          font-family='var(--font-sans)'
        >
          A MEDIDA
        </text>
        <text
          x='60'
          y='71'
          text-anchor='middle'
          font-size='26'
          font-weight='700'
          fill='var(--color-primary-ink)'
          font-family='var(--font-display)'
        >
          E / W
        </text>
        <path d='m48 83 8 7 16-16' fill='none' stroke='var(--color-ink)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' />
      </svg>
    </div>
    <div
      class='pointer-events-none absolute -top-7 right-4 flex rotate-8 items-center gap-2 rounded-2xl rounded-bl-sm border border-ink/15 bg-paper px-4 py-3 text-sm font-semibold shadow-sm'
      aria-hidden='true'
      data-profile-hello
    >
      ¡Hola!
      <svg class='h-5 w-6 text-primary-ink' viewBox='0 0 28 24' fill='none'>
        <path d='M3 9c3-4 3 9 7 5' stroke='currentColor' stroke-width='2' stroke-linecap='round' data-profile-wave />
        <path d='M10 6c3-4 3 14 7 10' stroke='currentColor' stroke-width='2' stroke-linecap='round' data-profile-wave />
        <path d='M17 3c3-4 3 19 7 15' stroke='currentColor' stroke-width='2' stroke-linecap='round' data-profile-wave />
      </svg>
    </div>
  </div>
  <div class='lg:pl-8'>
    <div class='mb-5 inline-flex items-center gap-3'>
      <span class='bg-primary/50 block h-px w-6'></span>
      <span class='text-xs font-medium tracking-[0.14em] uppercase text-primary-ink'>Diseño independiente, trato personal</span>
    </div>
    <h2 data-anim='titulo' class='text-[clamp(1.9rem,4.2vw,3rem)] leading-[1.08] font-bold tracking-[-0.035em]'>
      Tu proyecto merece atención de verdad.
    </h2>
    <p data-reading class='mt-6 max-w-xl text-lg leading-relaxed text-muted'>
      Trabajo contigo para convertir lo que hace especial a tu negocio en una página clara, cuidada y fácil de usar.
    </p>
    <p class='mt-4 max-w-xl leading-relaxed text-muted'>
      Estés donde estés en México, podemos empezar por una conversación. Me cuentas tu idea y encontramos una forma de llevarla a internet.
    </p>
    <a
      href={whatsappUrl}
      target='_blank'
      rel='noopener noreferrer'
      class='mt-7 inline-flex min-h-12 items-center gap-4 font-semibold underline decoration-stroke underline-offset-6'
    >
      Conversemos sobre tu idea <IconDiagonal class='size-5 text-primary' />
    </a>
  </div>
</section>
