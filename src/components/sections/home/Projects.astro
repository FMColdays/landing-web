---
import IconArrowCurve from '@icons/IconArrowCurve.svg'
import IconCheck from '@icons/IconCheck.svg'
import { PROJECTS } from '@/data'
import TrabajoCard from '@sections/home/ProjectCard.astro'
import ProjectControl from '@sections/home/ProjectControl.astro'
---

<section
  id='trabajo'
  class='group relative overflow-hidden bg-[radial-gradient(ellipse_at_50%_60%,var(--color-primary-pale)_0,transparent_64%)] py-20 lg:py-24'
>
  <div class='mx-auto w-full max-w-6xl px-6 sm:px-10 lg:px-16'>
    <div class='grid gap-6 md:grid-cols-[1.25fr_0.75fr] md:items-end md:gap-12' data-anim='bloque'>
      <div>
        <div class='mb-5 inline-flex items-center gap-3'>
          <span class='bg-primary/50 block h-px w-6'></span>
          <span class='text-xs font-medium tracking-[0.14em] uppercase text-primary-ink'>Proyectos reales</span>
        </div>
        <h2 data-anim='titulo' class='text-[clamp(1.9rem,4.2vw,3rem)] leading-[1.08] font-bold tracking-[-0.035em] max-w-2xl'>
          Cada negocio, una web con personalidad.
        </h2>
      </div>
      <p class='max-w-sm leading-relaxed text-muted md:ml-auto'>
        Una muestra de los sitios que he creado. Diseños distintos, hechos a la medida de cada negocio.
      </p>
    </div>
  </div>

  <div class='project-table mx-auto mt-12 w-full max-w-6xl px-6 sm:px-10 lg:grid lg:grid-cols-[0.75fr_1.25fr] lg:items-center lg:gap-6 lg:px-16 max-sm:px-0'>
    <div class='project-notes relative z-20 min-w-0 max-lg:px-6'>
      <div class='grid lg:min-h-80'>
        {PROJECTS.map((project, index) => (
          <div class='col-start-1 row-start-1 self-center' data-project-note hidden={index !== 0}>
            <p class='mb-4 flex items-center gap-3 text-xs tracking-[0.12em] text-primary-ink uppercase'>
              <span class='tabular-nums'>
                0{index + 1} / 0{PROJECTS.length}
              </span>
              <span class='h-px w-9 bg-primary/50' aria-hidden='true'></span>
              {project.categoria}
            </p>
            <h3 class='max-w-sm text-[clamp(2rem,3.8vw,3.5rem)] leading-[1.04] font-semibold tracking-tighter'>{project.nombre}</h3>
            <p class='mt-5 max-w-xs text-sm leading-relaxed text-muted'>{project.enfoque}</p>
            <p class='mt-6 inline-flex items-center gap-2 rounded-full border border-stroke bg-layer px-3 py-2 text-xs text-muted'>
              <IconCheck class='size-3.5' />
              Un diseño a la medida del negocio
            </p>
          </div>
        ))}
      </div>
      <ProjectControl />
      <IconArrowCurve class='mt-7 hidden w-44 text-primary-ink/60 lg:block' />
    </div>
    <div
      class='relative mt-10 h-145 touch-pan-y select-none [--ancho:16.25rem] [--paso:13deg] [--separacion:88] not-data-carousel-ready:h-auto sm:h-164 sm:[--ancho:20rem] sm:[--separacion:120] lg:mt-0 lg:h-166 lg:[--ancho:21rem] lg:[--separacion:115] max-sm:not-data-carousel-ready:px-6'
      data-arco
    >
      <ul class='absolute inset-x-0 top-0 h-full sin-carrusel:static sin-carrusel:grid sin-carrusel:grid-cols-2 sin-carrusel:gap-4 max-sm:sin-carrusel:grid-cols-1'>
        {PROJECTS.map((project, index) => (
          <TrabajoCard position={index} projects={project} />
        ))}
      </ul>
    </div>

    <p class='mt-4 text-center text-xs leading-relaxed text-muted lg:col-span-2 max-sm:px-6'>
      Elige con las flechas o las tarjetas laterales. Desplázate dentro de la captura para explorar el diseño.
    </p>
  </div>
</section>
