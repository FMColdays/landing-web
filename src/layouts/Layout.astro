---
import Head from '@components/shared/Head.astro'
import Animations from '@components/shared/Animations.astro'
import Seo from '@components/shared/Seo.astro'
import { htmlLang, SITE_URL } from '@config/app-config'
import { site } from '@config/site.mjs'
import '@styles/global.css'

interface Props {
  title?: string
  description?: string
  keywords?: string[]
  ogTitle?: string
  ogDescription?: string
  ogImage?: string
  canonical?: string
  ogUrl?: string
  schemaType?: 'service' | 'software'
  noindex?: boolean
}

const canonicalPorDefecto = new URL(Astro.url.pathname, SITE_URL).href

const {
  title = 'Diseño de páginas web para negocios en México',
  description = 'Páginas web y landing pages para negocios de todo México. Diseño a medida, hecho desde cero, con trato directo. Cotiza tu sitio por WhatsApp.',
  keywords = [],
  ogTitle = title,
  ogDescription = description,
  ogImage = '/images/og/og-image-home.webp',
  canonical = canonicalPorDefecto,
  ogUrl = canonical,
  schemaType,
  noindex = !site.publicLaunch,
} = Astro.props

const isHome = Astro.url.pathname === '/'
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <Head>
      <Seo
        canonical={canonical}
        description={description}
        isHome={isHome}
        keywords={keywords}
        noindex={noindex}
        ogDescription={ogDescription}
        ogImage={ogImage}
        ogTitle={ogTitle}
        ogUrl={ogUrl}
        schemaType={schemaType}
        title={title}
      />
    </Head>
  </head>
  <body class='bg-paper text-ink antialiased'>
    <slot />
    <Animations />
  </body>
</html>
